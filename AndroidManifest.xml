<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.schuurman.rvc">

    <!-- Camera preview -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CAMERA_HEADLESS_SYSTEM_USER" />
    <uses-permission android:name="android.permission.SYSTEM_CAMERA" />

    <!-- Receive boot to start gear monitoring early -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Car property access (signature/privileged in AAOS) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- Optional but often useful for uninterrupted UX across users -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />

    <application
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:usesCleartextTraffic="false">

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <service
            android:name=".GearMonitorService"
            android:directBootAware="true"
            android:exported="false" />

        <activity
            android:name=".RearViewCameraActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.RvcCamera"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:resizeableActivity="false">
            <!-- Safety view: allowed while driving (car UX restrictions), settings panel included. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- Settings, shown as a top-level entry in CarSettings (injected settings: system apps only). -->
        <activity
            android:name=".RvcSettingsActivity"
            android:exported="true"
            android:label="@string/rvc_settings_title"
            android:theme="@style/Theme.RvcSettings">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.device" />
            <meta-data android:name="com.android.settings.title"
                android:resource="@string/rvc_settings_title" />
            <meta-data android:name="com.android.settings.summary"
                android:resource="@string/rvc_settings_summary" />
            <meta-data android:name="com.android.settings.icon"
                android:resource="@drawable/ic_rvc_settings" />
        </activity>

    </application>
</manifest>
