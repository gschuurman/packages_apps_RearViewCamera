android_app {
    name: "RearViewCamera",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    platform_apis: true,
    privileged: true,
    certificate: "platform",

    // Ensure car framework is on the classpath for compilation.
    libs: [
        "android.car",
    ],

    // The settings screen (RvcSettingsActivity) uses the car UI library, like CarSettings.
    static_libs: [
        "androidx.fragment_fragment",
        "androidx.preference_preference",
        "car-ui-lib",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-com.schuurman.rvc",
    src: "permissions/privapp-permissions-com.schuurman.rvc.xml",
    sub_dir: "permissions",
    filename_from_src: true,

    system_ext_specific: false,
    product_specific: false,
    vendor: false,
}