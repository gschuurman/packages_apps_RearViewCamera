# Rear view camera while Android boots (see rvc_early.cpp). Runs as AID_AUTOMOTIVE_EVS: the only
# client cameraserver serves before system_server is up. Exits by itself once Android has booted.
service rvc_early /system/bin/rvc_early
    user automotive_evs
    group automotive_evs camera
    oneshot
    disabled

# Same moment as the car display proxy, which it draws through.
on late-init
    start rvc_early
